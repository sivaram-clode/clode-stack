# VITE_* service URLs baked into the console-web static build (Vite loads this as
# .env.production). clode-stack OWNS these — committed here so the build works
# even from a git worktree of console-web (whose .env.local is gitignored and
# absent) and despite console-web's .dockerignore excluding .env*.
#
# All services route through the traefik ingress on host 8080 by Host header.
VITE_GATEWAY_BASE_URL=http://aramb-gateway.localhost:8080
VITE_RAKSHA_BASE_URL=http://raksha.localhost:8080
VITE_BRAHMI_BASE_URL=http://brahmi.localhost:8080
VITE_JUMBO_BASE_URL=http://jumbo.localhost:8080/api/v1
VITE_CHACHING_BASE_URL=http://cha-ching.localhost:8080/api/v1
VITE_TOOLKIT_PROXY_BASE_URL=http://toolkit-proxy.localhost:8080/api/v1
VITE_SKILLS_REGISTRY_BASE_URL=http://skills-registry.localhost:8080
VITE_IKKI_BASE_URL=http://ikki.localhost:8080
# Local-stack dev-JWT sign-in (raksha /generate-dev-jwt-access-token). LOCAL ONLY.
VITE_DEV_JWT=1
